# Server & Database
APP_ENV=production
PORT=8000
SQLITE_DB_PATH=./voice_enterprise.db
WEBHOOK_SECRET=replace_with_strong_shared_secret

# Voice AI Orchestrator (Vapi / Retell)
VAPI_API_KEY=vapi_live_xxxxxxxxxxxxxxxxxxxx
RETELL_API_KEY=retell_live_xxxxxxxxxxxxxxxxxxxx

# Telephony Carrier (Twilio / Telnyx)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15550199999
HUMAN_ESCALATION_NUMBER=+15550123456

# Calendar & CRM Downstream
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxx
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxxx
SLACK_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/T000/B000/XXXX

# Client Value Telemetry Defaults
DEFAULT_AVG_TICKET_USD=450.00
DEFAULT_CLOSE_RATE=0.35
